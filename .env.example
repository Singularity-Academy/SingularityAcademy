# 数据库配置
DB_HOST=mysql
DB_PORT=3306
DB_USER=sa_user
DB_PASSWORD=your_secure_password
DB_NAME=singularity_academy

# JWT 配置
JWT_SECRET=your_jwt_secret_key_here

# OpenAI API 配置
OPENAI_API_KEY=your_openai_api_key_here

# Email 配置 (可选)
EMAIL_HOST=smtp.exmail.qq.com
EMAIL_PORT=465
EMAIL_USER=admin@your-domain.com
EMAIL_PASSWORD=your_email_password

# 服务端口配置 (Docker 内部使用)
FRONTEND_PORT=3000
BACKEND_PORT=8080
AI_ENGINE_PORT=8000
CADDY_PORT=1298