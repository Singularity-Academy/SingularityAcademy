:1298 {
	# API 路由反向代理到后端容器
	reverse_proxy /api/* backend:8080

	# AI 路由反代到 AI 引擎容器
	reverse_proxy /ai/* ai-engine:8000
	# WebSocket 路由反代到 AI 引擎容器
	reverse_proxy /ai/principal-ai/ws/* ai-engine:8000

	# 其他路由反向代理到前端容器
	reverse_proxy /* frontend:3000

	# CORS 设置
	header {
		Access-Control-Allow-Origin: *
		Access-Control-Allow-Methods: GET, POST, PUT, DELETE, OPTIONS
		Access-Control-Allow-Headers: Content-Type, X-Real-IP, Authorization, Connection, Upgrade
		header_up Host {host}
		header_up X-Real-IP {remote}
		Access-Control-Allow-Credentials true
		Access-Control-Allow-WebSockets true
		# 为 WebSocket 连接添加必要的头部
		header_up Connection {>Connection}
		header_up Upgrade {>Upgrade}
	}
}
